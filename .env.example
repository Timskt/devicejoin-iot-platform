# LLM 配置 (支持 OpenAI / DeepSeek / Ollama / Azure)
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 数据库 (生产环境必须修改)
DB_PASSWORD=change-me-to-random-string

# JWT (生产环境必须修改)
JWT_SECRET_KEY=change-me-to-random-string-at-least-32-chars

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# 向量检索
VECTOR_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.7

# Sentry (可选 - 错误追踪)
SENTRY_DSN=
