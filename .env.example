# LLM 配置 (默认 OpenCode Go，兼容 OpenAI / DeepSeek)
LLM_API_KEY=sk-your-key-here
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-pro

# 数据库 (生产环境必须修改)
DB_PASSWORD=change-me-to-random-string

# JWT (生产环境必须修改)
JWT_SECRET_KEY=change-me-to-random-string-at-least-32-chars

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# 向量检索
VECTOR_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.7

# CORS (生产环境改为实际前端域名，逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sentry (可选 - 错误追踪)
SENTRY_DSN=
